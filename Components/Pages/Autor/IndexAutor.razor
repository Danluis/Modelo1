@page "/Autor/Index"
@inject AutorService AutorService

<PageTitle>Registro de Autor</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Autor</h5>
            <a href="/Autor/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">
                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Id">Id</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                        <button type="button" class="btn btn-outline-secondary bi bi-x-lg" @onclick="Restablecer"></button>
                    </div>
                </div>
            </div>

            <table class="table table-hover">
                <thead class="table table-striped text-black">
                    <tr>
                        <th>AutorId</th>
                        <th>Nombres</th>
                        <th>Nacionalidad</th>
                        <th>Fecha Nacimiento</th>
                        <th>Sueldo</th>
                        <th>Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ListaAutor)
                    {
                        <tr>
                            <td>@item.AutorId</td>
                            <td>@item.Nombres</td>
                            <td>@item.Nacionalidad</td>
                            <td>@item.FechaNacimiento.ToShortDateString()</td>
                            <td>@item.Sueldo</td>
                            <td class="text-center">
                                <a href="/Autor/Edit/@item.AutorId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad: @ListaAutor.Count()</label>
            <label>Total: @ListaAutor.Sum(m => m.Sueldo)</label>
        </div>
    </div>
</div>

@code {
    public List<Autor> ListaAutor { get; set; } = new List<Autor>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaAutor = await AutorService.GetList(m => m.AutorId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Nombres")
            {
                ListaAutor = await AutorService.GetList(m => m.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Id")
            {
                if (int.TryParse(ValorFiltro, out int idBuscado))
                {
                    ListaAutor = await AutorService.GetList(m => m.AutorId == idBuscado);
                }
                else
                {
                    ListaAutor = new List<Autor>();
                }
            }
        }
        else
        {
            ListaAutor = await AutorService.GetList(m => m.AutorId > 0);
        }
    }

    private async Task Restablecer()
    {
        ListaAutor = await AutorService.GetList(m => m.AutorId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
